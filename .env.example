# AutoSell ortam değişkenleri
# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun. ".env" git'e eklenmez.
# Panelden (Ayarlar) kaydedilen değerler bu dosyadakilerin önüne geçer.

# Yapay zekâ sağlayıcısı: openai (OpenAI uyumlu API) ya da claude
AUTOSELL_AI_PROVIDER=openai
OPENAI_BASE_URL=https://betaapiv2.llmapi.art/v1
AUTOSELL_OPENAI_MODEL=muse-spark-1.3
OPENAI_API_KEY=

# Hızlı karar motoru (fırsat adaylarını saniyeler içinde süzer): jev | laya | kapali
# Boş bırakılan satırlarda varsayılan kullanılır; ayrıntı README > "Hızlı karar motoru".
AUTOSELL_DECISION_ENGINE=jev
# Kendi sağlayıcınız (boşsa jev -> https://betaapiv2.llmapi.art/v1, laya -> http://127.0.0.1:8000):
#   OpenRouter: https://openrouter.ai/api/v1   (model: typesafe/jev-1.13)
#   TypeSafe:   https://api.typesafe.ai/v1      (model: jev-latest)
#   Laya:       http://127.0.0.1:8000 ya da kendi laya-serve sunucunuz (model: multilingual)
# AUTOSELL_DECISION_URL=
# AUTOSELL_DECISION_MODEL=
# Boşsa: varsayılan sunucuda OPENAI_API_KEY, Laya'da LAYA_API_KEY kullanılır
# AUTOSELL_DECISION_API_KEY=

# Claude kullanmak isterseniz:
# AUTOSELL_AI_PROVIDER=claude
# ANTHROPIC_API_KEY=

# Telegram bildirimleri (isteğe bağlı)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Paneli telefondan açmak için şifre
# AUTOSELL_PANEL_PASSWORD=
