# AutoSell ortam değişkenleri
# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun. ".env" git'e eklenmez.
# Panelden (Ayarlar) kaydedilen değerler bu dosyadakilerin önüne geçer.

# Yapay zekâ sağlayıcısı: openai (OpenAI uyumlu API) ya da claude
AUTOSELL_AI_PROVIDER=openai
OPENAI_BASE_URL=https://betaapiv2.llmapi.art/v1
AUTOSELL_OPENAI_MODEL=muse-spark-1.3
OPENAI_API_KEY=

# Claude kullanmak isterseniz:
# AUTOSELL_AI_PROVIDER=claude
# ANTHROPIC_API_KEY=

# Telegram bildirimleri (isteğe bağlı)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Paneli telefondan açmak için şifre
# AUTOSELL_PANEL_PASSWORD=
